# Copy to .env.local for local dev, or set these in your hosting provider's
# environment variable settings for production builds. See README.md.

VITE_LEAD_ENDPOINT=

# GA4 measurement ID (G-7SF9KSH92Z) is already baked into src/lib/analytics.ts
# as a default, so you don't need to set this unless you want to override it
# (e.g. point a staging build at a different GA4 property).
VITE_GA_MEASUREMENT_ID=

# Set this once a Google Ads account exists and gets linked to the GA4
# property above — see README "Next: connect Google Ads" section.
VITE_GOOGLE_ADS_ID=
